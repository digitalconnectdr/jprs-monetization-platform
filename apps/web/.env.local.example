# Copiar este archivo a .env.local (en esta misma carpeta, apps/web/) y completar
# con los valores reales del proyecto Supabase. .env.local está en .gitignore —
# nunca se commitea. Nunca pegar estos valores reales en el chat con el agente.

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → Data API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → Data API → Project API keys → service_role
# SECRETO REAL — solo uso server-side, nunca en código con NEXT_PUBLIC_, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
